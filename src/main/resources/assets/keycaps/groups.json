{
  "_comment": "Colour groups for Keycaps. Copy this file to config/keycaps/groups.json to change it. A rule's 'match' is a regular expression, searched in '<action id> <category or mod name>' in lower case; the first rule that matches decides. Group names are translated with keycaps.group.<id>. 'row': 2 puts a group on the legend's second row (mods with their own colour).",
  "groups": [
    {"id": "movement", "color": "#3B7DD8"},
    {"id": "action", "color": "#C8503C"},
    {"id": "items", "color": "#C98A2E"},
    {"id": "camera", "color": "#8559C9"},
    {"id": "map", "color": "#2F9E5E"},
    {"id": "social", "color": "#2C9DAD"},
    {"id": "graphics", "color": "#A8962C"},
    {"id": "tools", "color": "#6B7C8E"},
    {"id": "creative", "color": "#C2559E"},
    {"id": "other", "color": "#55606C"},
    {"id": "litematica", "color": "#7FB539", "row": 2},
    {"id": "tweakeroo", "color": "#8E5B3A", "row": 2},
    {"id": "minihud", "color": "#4F5BD5", "row": 2},
    {"id": "axiom", "color": "#E0457B", "row": 2}
  ],
  "rules": [
    {"group": "litematica", "match": "^litematica:"},
    {"group": "tweakeroo", "match": "^tweakeroo:"},
    {"group": "minihud", "match": "^minihud:"},
    {"group": "axiom", "match": "axiom"},
    {"group": "movement", "match": "^(multi\\.)?(key\\.(forward|left|back|right|jump|sneak|sprint|crawl)|toggle\\.key\\.(sprint|sneak)|multi\\.toggle\\.key\\.(sprint|sneak)|multi\\.toggle\\.options\\.autojump)\\b"},
    {"group": "movement", "match": "elytra|ghastcontrols|fly-speed|flyspeed|scrollwalk|invmove|jjelytraswap"},
    {"group": "action", "match": "^(multi\\.)?key\\.(attack|use|pickitem)\\b|reacharound|reachbehind|accurateblockplacement|clienttweaks\\.(mine_single_block|disable_log_stripping|disable_step_assist)"},
    {"group": "items", "match": "^(multi\\.)?key\\.(drop|inventory|swapoffhand|hotbar\\.\\d|savetoolbaractivator|loadtoolbaractivator)\\b|clientsort|lockedinslots|trade_cycling|inventory|item"},
    {"group": "camera", "match": "^(multi\\.)?key\\.(toggleperspective|smoothcamera)\\b|zoom|freecam|third_person|thirdperson|shouldersurfing|perspective|camera|picturemode"},
    {"group": "map", "match": "xaero|map|waypoint|minimap|atlas"},
    {"group": "social", "match": "^(multi\\.)?key\\.(chat|command|playerlist|friends|socialinteractions)\\b|twemoji|emoji|nametag|skinshuffle|voice|heywiki|wiki"},
    {"group": "graphics", "match": "^(multi\\.)?key\\.(togglegui|fullscreen|togglespectatorshadereffects)\\b|iris|shader|sodium|lambdynlights|dynamic_fps|lumina|cloud|entityculling|atmospherics|sky"},
    {"group": "creative", "match": "axiom|worldedit|litematica|tweakeroo|schematic|flashback|armorstands|bcbui|headbrowser|creative"},
    {"group": "tools", "match": "^(multi\\.)?key\\.(debug\\.|screenshot|advancements|quickactions|spectator)|minihud|jade|muffler|music|modmenu|screenshotgallery|settings|config|keycaps|debug"}
  ]
}
