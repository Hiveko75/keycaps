{
  "_comment": "When actions can fire, for the smart conflict check: two actions on one key only count as a conflict when they share a situation. Copy this file to config/keycaps/situations.json to change it. A rule's 'match' is a regular expression, searched in '<action id> <category or mod name>' in lower case; the first rule that matches decides. 'when': world (playing, no screen open: the default for key bindings), menu (inventory and container screens), chat, passive (only changes what is shown while held: never a conflict), or any other word for a situation of its own. 'adds': ctrl / alt / shift when the mod adds that key itself, so the action is shown on that layer. 'shares': action ids the action is made to share its key with, never a conflict with those (Litematica's schematic pick block only acts on schematic blocks and leaves the key to Pick Block otherwise). 'needs': the options the action needs ('<class>#<static field>', one or a list: a malilib option such as a Tweakeroo tweak, or a boolean field); while one of them is off the action does nothing, so it is shown as switched off and never counts as a conflict. malilib hotkeys already say whether they also work in screens.",
  "_fixed": "Keys mods read directly instead of registering them, shown on the map with a 'fixed in' note and part of the conflict check. 'key': one key or a list (Minecraft key names), or 'with': the key binding whose key is used, with 'adds' (ctrl / alt / shift) held on top. 'mod': the mod id that must be loaded (minecraft for the game itself). 'name': a translation key, 'fallback' when the language has none. 'when', 'needs' and 'shares' as in the rules. 'unless': a key binding id; when it exists (a newer version of the mod made the key a key binding) the entry is left out. 'while': a key binding whose key is held for this action (Leawind's Adjust Camera + mouse wheel): its Ctrl / Alt / Shift layer, or a layer of its own for any other key. Keys keycaps.mouse.wheel and keycaps.mouse.move are the mouse wheel and mouse movement.",
  "fixed": [
    {"id": "minecraft:drop_stack", "with": "key.drop", "adds": "ctrl", "when": ["world", "menu"], "name": "keycaps.fixed.drop_stack", "fallback": "Drop whole stack"},
    {"id": "minecraft:pick_with_data", "with": "key.pickItem", "adds": "ctrl", "name": "keycaps.fixed.pick_with_data", "fallback": "Pick Block with its data (creative)"},
    {"id": "scrollwalk:speed", "mod": "scrollwalk", "unless": "key.scrollwalk.speed", "key": ["key.keyboard.left.alt", "key.keyboard.right.alt"], "when": ["world", "litematica_tool"], "needs": "net.naw.scrollwalk.ScrollWalk#config.modEnabled", "shares": ["litematica:toolSelectModifierBlock1", "litematica:toolSelectModifierBlock2"], "name": "keycaps.fixed.scrollwalk_speed", "fallback": "Walking speed (hold, then mouse wheel)"},
    {"id": "heywiki:held_item", "mod": "heywiki", "with": "key.heywiki.open", "adds": "alt", "name": "keycaps.fixed.heywiki_held_item", "fallback": "Wiki page of the item in hand"},
    {"id": "xaeroworldmap:dimension_back", "mod": "xaeroworldmap", "with": "gui.xaero_toggle_dimension", "adds": "shift", "name": "keycaps.fixed.xaero_dimension_back", "fallback": "Toggle dimension backwards"},
    {"id": "languagereload:cycle", "mod": "languagereload", "with": "key.debug.reloadLanguages", "adds": "shift", "name": "keycaps.fixed.cycle_languages", "fallback": "Cycle languages"},
    {"id": "minecraft:hotbar_scroll", "key": "keycaps.mouse.wheel", "name": "keycaps.fixed.hotbar_scroll", "fallback": "Change hotbar slot"},
    {"id": "minecraft:look", "key": "keycaps.mouse.move", "name": "keycaps.fixed.look", "fallback": "Look around"},
    {"id": "leawind_third_person:camera_distance", "mod": "leawind_third_person", "while": "key.leawind_third_person.adjust_camera", "key": "keycaps.mouse.wheel", "name": "keycaps.fixed.camera_distance", "fallback": "Camera distance"},
    {"id": "leawind_third_person:camera_offset", "mod": "leawind_third_person", "while": "key.leawind_third_person.adjust_camera", "key": "keycaps.mouse.move", "name": "keycaps.fixed.camera_offset", "fallback": "Camera offset"},
    {"id": "fly-speed-modifier:speed", "mod": "fly-speed-modifier", "while": "key.fly-speed-modifier.adjust_speed", "key": "keycaps.mouse.wheel", "when": ["flying"], "name": "keycaps.fixed.fly_speed", "fallback": "Flight speed"},
    {"id": "scrollwalk:wheel_speed", "mod": "scrollwalk", "while": "key.scrollwalk.speed", "key": "keycaps.mouse.wheel", "needs": "net.naw.scrollwalk.ScrollWalk#config.modEnabled", "name": "keycaps.fixed.walking_speed", "fallback": "Walking speed"},
    {"id": "zoomify:zoom_level", "mod": "zoomify", "while": "zoomify.key.zoom", "key": "keycaps.mouse.wheel", "name": "keycaps.fixed.zoom_level", "fallback": "Zoom level"}
  ],
  "rules": [
    {"match": "^twemoji\\.key\\.picker", "when": ["chat"], "adds": "ctrl"},
    {"match": "^key\\.inventory ", "when": ["world", "menu"]},
    {"match": "^key\\.hotbar\\.\\d", "when": ["world", "menu"]},
    {"match": "^key\\.(drop|swapoffhand) ", "when": ["world", "menu"]},
    {"match": "^key\\.(screenshot|fullscreen) ", "when": ["world", "menu", "chat"]},
    {"match": "^key\\.jade\\.show_details", "when": ["passive"]},
    {"match": "^key\\.fly-speed-modifier\\.adjust_speed ", "when": ["flying"]},
    {"match": "^key\\.debug\\.crash ", "when": ["hold_10s"]},
    {"match": "^key\\.clientsort\\.(op\\.|cancelauto)", "when": ["menu"]},
    {"match": "^key\\.lockedinslots\\.", "when": ["menu"]},
    {"match": "^key\\.optigui\\.inspect", "when": ["menu"]},
    {"match": "^flashback\\.keybinds\\.timeline_", "when": ["replay"]},
    {"match": "^tweakeroo:flexibleblockplacement(adjacent|offset|rotation) ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_FLEXIBLE_BLOCK_PLACEMENT"},
    {"match": "^tweakeroo:accurateblockplacement(into|reverse) ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_ACCURATE_BLOCK_PLACEMENT"},
    {"match": "^tweakeroo:hotbarswap(1|2|3|base) ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_HOTBAR_SWAP"},
    {"match": "^tweakeroo:hotbarscroll ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_HOTBAR_SCROLL"},
    {"match": "^tweakeroo:inventorypreview(togglescreen)? ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_INVENTORY_PREVIEW"},
    {"match": "^tweakeroo:playerinventorypeek ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_PLAYER_INVENTORY_PEEK"},
    {"match": "^tweakeroo:placementymirror ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_Y_MIRROR"},
    {"match": "^tweakeroo:elytracamera ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_ELYTRA_CAMERA"},
    {"match": "^tweakeroo:swapspyglassandactivate ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_SPYGLASS_USES_TWEAK_ZOOM"},
    {"match": "^tweakeroo:areaselectionoffset ", "needs": "fi.dy.masa.tweakeroo.config.FeatureToggle#TWEAK_AREA_SELECTOR"},
    {"match": "^minihud:requiredkey ", "when": ["passive"]},
    {"match": "^minihud:inventorypreview(togglescreen)? ", "needs": "fi.dy.masa.minihud.config.Configs$Generic#INVENTORY_PREVIEW_ENABLED"},
    {"match": "^litematica:(renderoverlaythroughblocks|invertghostblockrenderstate|invertoverlayrenderstate|renderinfooverlay) ", "when": ["passive"]},
    {"match": "^litematica:easyplaceusekey ", "needs": "fi.dy.masa.litematica.config.Configs$Generic#EASY_PLACE_MODE", "shares": ["key.use"]},
    {"match": "^litematica:pickblock(first|last) ", "needs": ["fi.dy.masa.litematica.config.Configs$Generic#PICK_BLOCK_ENABLED", "fi.dy.masa.litematica.config.Configs$Visuals#ENABLE_RENDERING", "fi.dy.masa.litematica.config.Configs$Visuals#ENABLE_SCHEMATIC_RENDERING"], "shares": ["key.pickItem"]},
    {"match": "^litematica:toolselectmodifierblock[12] ", "when": ["litematica_tool"], "needs": ["fi.dy.masa.litematica.config.Configs$Generic#TOOL_ITEM_ENABLED", "fi.dy.masa.litematica.config.Configs$Visuals#ENABLE_RENDERING"], "shares": ["litematica:selectionNudgeModifier", "litematica:selectionGrabModifier", "litematica:selectionGrowModifier", "litematica:operationModeChangeModifier", "litematica:schematicVersionCycleModifier"]},
    {"match": "^litematica:(toolplacecorner[12]|toolselectelements|toolselectmodifierblock[12]|operationmodechangemodifier|selection(nudge|grab|grow)modifier|schematicversioncyclemodifier) ", "when": ["litematica_tool"], "needs": ["fi.dy.masa.litematica.config.Configs$Generic#TOOL_ITEM_ENABLED", "fi.dy.masa.litematica.config.Configs$Visuals#ENABLE_RENDERING"]}
  ]
}
